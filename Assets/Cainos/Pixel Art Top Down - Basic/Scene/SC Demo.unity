  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b2edba2a98a454a65b8936bdfc91d8df, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialoguePanel: {fileID: 56202115}
  dialogueButtonPanel: {fileID: 1461873645}
  QuestPanel: {fileID: 26781335}
  questTextBox: {fileID: 1355683668}
  questDescription: "If you can help me find my magic wand, I\u2019ll help you fight
    these monsters and join your party as the mage!"
  clickToContinueText: {fileID: 955222327}
  speakerNameText: {fileID: 468503039}
  dialogueText: {fileID: 506287302}
  choiceContainer: {fileID: 377762796}
  choiceButtonPrefab: {fileID: 10634998837125565, guid: 80426c892be634d2c81aae8e6e07e545,
    type: 3}
  dialogueNodes:
  - speakerName: Brianna
    dialogueText: Who are you???
    choices:
    - choiceText: Continue
      nextNodeIndex: 1
    endsDialogue: 0
  - speakerName: Brianna
    dialogueText: Wait, nevermind, it's not the time for that! I can't find it!
    choices:
    - choiceText: '?'
      nextNodeIndex: 2
    - choiceText: '!'
      nextNodeIndex: 3
    endsDialogue: 0
  - speakerName: Brianna
    dialogueText: "Huh? You said what am I looking for? My magic wand, of course!
      I can\u2019t find it\u2026 I think I lost it somewhere near those pillars,
      but if I go down there they\u2019ll tear me to shreds! What do I do?!"
    choices:
    - choiceText: We give a cheereful smile.
      nextNodeIndex: 4
    endsDialogue: 0
  - speakerName: Brianna
    dialogueText: "Did you just say you\u2019ll help me? Thanks! Wait you don\u2019t
      even know what I\u2019m looking for. How would you be able to help me find
      it\u2026?"
    choices:
    - choiceText: We give a sheepish smile.
      nextNodeIndex: 5
    endsDialogue: 0
  - speakerName: Brianna
    dialogueText: "You\u2019ll get it for me? Okay! Thank you!"
    choices:
    - choiceText: No problem!
      nextNodeIndex: 6
    endsDialogue: 0
  - speakerName: Brianna
    dialogueText: "I\u2019m a mage!"
    choices:
    - choiceText: '?'
      nextNodeIndex: 6
    endsDialogue: 0
  - speakerName: Brianna
    dialogueText: "If you can help me find my magic wand, I\u2019ll help you fight
      these monsters and join your party as the mage!"
    choices:
    - choiceText: alright
      nextNodeIndex: 0
    endsDialogue: 1
  typeSpeed: 0.03
